<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Special Wishes Website ❤️</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      overflow-x: hidden;
      background: linear-gradient(135deg, #ff4e8a, #ff8fb1, #ffc2d1);
      min-height: 100vh;
      color: white;
      text-align: center;
      position: relative;
    }

    .overlay {
      background: rgba(0,0,0,0.25);
      min-height: 100vh;
      padding: 30px 15px;
    }

    h1 {
      font-size: 3rem;
      margin-top: 20px;
      animation: glow 2s infinite alternate;
    }

    @keyframes glow {
      from {
        text-shadow: 0 0 10px white;
      }
      to {
        text-shadow: 0 0 25px #ff0066;
      }
    }

    .typing {
      width: 100%;
      max-width: 700px;
      margin: 20px auto;
      font-size: 1.2rem;
      line-height: 1.8;
      min-height: 100px;
    }

    .gallery {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 40px;
    }

    .gallery img {
      width: 280px;
      height: 350px;
      object-fit: cover;
      border-radius: 20px;
      border: 4px solid white;
      transition: 0.4s;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    .gallery img:hover {
      transform: scale(1.05);
    }

    .love-btn {
      margin-top: 40px;
      padding: 15px 35px;
      border: none;
      border-radius: 50px;
      background: white;
      color: #ff0066;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .love-btn:hover {
      transform: scale(1.1);
      background: #ffe6ef;
    }

    .popup {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      background: white;
      color: #ff0066;
      padding: 30px;
      border-radius: 20px;
      width: 90%;
      max-width: 400px;
      z-index: 1000;
      transition: 0.4s;
      box-shadow: 0 15px 40px rgba(0,0,0,0.5);
    }

    .popup.active {
      transform: translate(-50%, -50%) scale(1);
    }

    .popup h2 {
      margin-bottom: 15px;
    }

    .close-btn {
      margin-top: 15px;
      padding: 10px 25px;
      border: none;
      background: #ff0066;
      color: white;
      border-radius: 30px;
      cursor: pointer;
    }

    .heart {
      position: fixed;
      color: white;
      font-size: 20px;
      animation: float 6s linear infinite;
      opacity: 0.7;
      z-index: 1;
    }

    @keyframes float {
      0% {
        transform: translateY(100vh) scale(0);
      }
      100% {
        transform: translateY(-10vh) scale(1.5);
      }
    }

    footer {
      margin-top: 60px;
      padding-bottom: 20px;
      font-size: 1rem;
    }

    audio {
      display: none;
    }

    @media(max-width: 768px) {
      h1 {
        font-size: 2.2rem;
      }

      .typing {
        font-size: 1rem;
      }

      .gallery img {
        width: 90%;
        height: auto;
      }
    }
  </style>
</head>
<body>

  <div class="overlay">

    <h1 id="mainTitle">A Special Surprise ❤️</h1>

    <div style="margin-top:25px;">
      <select id="themeSelector" onchange="changeTheme()" style="padding:12px 20px; border:none; border-radius:30px; font-size:1rem; cursor:pointer;">
        <option value="love">Romantic ❤️</option>
        <option value="bestie">Best Friend 🌸</option>
        <option value="birthday">Birthday 🎂</option>
        <option value="mother">Mother's Day 💐</option>
        <option value="father">Father's Day 👑</option>
      </select>
    </div>

    <div class="typing" id="typing"></div>

    <div class="gallery">
      <img src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?q=80&w=1000&auto=format&fit=crop" alt="Love 1">

      <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=1000&auto=format&fit=crop" alt="Love 2">

      <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?q=80&w=1000&auto=format&fit=crop" alt="Love 3">
    </div>

    <button class="love-btn" onclick="showPopup()">Click Here ❤️</button>

    <footer>
      Made With Love 💖
    </footer>
  </div>

  <div class="popup" id="popup">
    <h2>I Have Something To Say ❤️</h2>
    <p>
      You are the most beautiful part of my life. ✨<br><br>
      Every moment with you feels magical.
    </p>

    <button class="close-btn" onclick="closePopup()">Close</button>
  </div>

  <!-- Background Music -->
  <audio autoplay loop>
    <source src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8c8a73467.mp3?filename=romantic-love-11786.mp3" type="audio/mp3">
  </audio>

  <script>
    // Typing Effect
    let text = "You are the reason behind my smile, my happiness, and my heartbeats ❤️";

    let i = 0;

    function typingEffect() {
      if(i < text.length) {
        document.getElementById("typing").innerHTML += text.charAt(i);
        i++;
        setTimeout(typingEffect, 60);
      }
    }

    typingEffect();

    function resetTyping(newText) {
      text = newText;
      i = 0;
      document.getElementById("typing").innerHTML = "";
      typingEffect();
    }

    function changeTheme() {
      const value = document.getElementById("themeSelector").value;
      const title = document.getElementById("mainTitle");
      const popup = document.querySelector(".popup p");

      if(value === "love") {
        title.innerHTML = "For My Special Person ❤️";
        resetTyping("You are the reason behind my smile, my happiness, and my heartbeats ❤️");
        popup.innerHTML = "You are the most beautiful part of my life ✨<br><br>Every moment with you feels magical.";
      }

      if(value === "bestie") {
        title.innerHTML = "To My Best Friend 🌸";
        resetTyping("A best friend like you makes every moment special 🌟");
        popup.innerHTML = "Thank you for always being there for me 💖<br><br>You are truly irreplaceable.";
      }

      if(value === "birthday") {
        title.innerHTML = "Happy Birthday 🎂";
        resetTyping("May your day be filled with happiness, laughter, and unforgettable memories 🎉");
        popup.innerHTML = "Wishing you success, joy, and endless smiles on your special day 🎁";
      }

      if(value === "mother") {
        title.innerHTML = "Happy Mother's Day 💐";
        resetTyping("Thank you Mom for your endless love and sacrifices ❤️");
        popup.innerHTML = "You are the heart of our family and the strongest woman ever 🌸";
      }

      if(value === "father") {
        title.innerHTML = "Happy Father's Day 👑";
        resetTyping("Dad, your support and guidance mean everything to me 💙");
        popup.innerHTML = "Thank you for being my hero, protector, and inspiration 👑";
      }
    }

    // Popup
    function showPopup() {
      document.getElementById("popup").classList.add("active");
    }

    function closePopup() {
      document.getElementById("popup").classList.remove("active");
    }

    // Floating Hearts
    function createHeart() {
      const heart = document.createElement('div');
      heart.classList.add('heart');
      heart.innerHTML = '❤️';

      heart.style.left = Math.random() * 100 + 'vw';
      heart.style.fontSize = Math.random() * 20 + 15 + 'px';
      heart.style.animationDuration = Math.random() * 3 + 3 + 's';

      document.body.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, 6000);
    }

    setInterval(createHeart, 300);
  </script>

</body>
</html>
